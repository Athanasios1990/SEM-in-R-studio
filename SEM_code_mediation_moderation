# =========================================
# 12. Predictive relevance (Q square)
# Cross-validated construct-level approximation
# =========================================

# Function to compute cross-validated Q²
compute_q2_cv <- function(data, formula, target, k = 10, seed = 123) {
  set.seed(seed)
  
  n <- nrow(data)
  folds <- sample(rep(1:k, length.out = n))
  pred <- rep(NA, n)
  
  for (i in 1:k) {
    train_data <- data[folds != i, , drop = FALSE]
    test_data  <- data[folds == i, , drop = FALSE]
    
    model <- lm(formula, data = train_data)
    pred[folds == i] <- predict(model, newdata = test_data)
  }
  
  actual <- data[[target]]
  
  # Prediction error sum of squares
  press <- sum((actual - pred)^2, na.rm = TRUE)
  
  # Sum of squares of observations around the grand mean
  sso <- sum((actual - mean(actual, na.rm = TRUE))^2, na.rm = TRUE)
  
  q2 <- 1 - (press / sso)
  
  return(list(
    Q2 = q2,
    PRESS = press,
    SSO = sso,
    Predicted = pred
  ))
}

# Q² for Innovation
q2_inn <- compute_q2_cv(
  data = scores,
  formula = INN ~ EO + MAN + `EO*MAN`,
  target = "INN",
  k = 10,
  seed = 123
)

cat("\n================ Q SQUARE ================\n")
cat("Q² for INN =", round(q2_inn$Q2, 2), "\n")

# Optional: Q² for Management
q2_man <- compute_q2_cv(
