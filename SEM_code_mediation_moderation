# =========================================
# 9b. Discriminant validity: HTMT
# Manual calculation
# =========================================

# Define indicator sets
EO_items  <- SEM_data[, c("EO1", "EO2", "EO3", "EO4")]
MAN_items <- SEM_data[, c("MAN1", "MAN2", "MAN3")]
INN_items <- SEM_data[, c("INN1", "INN2", "INN3")]

# Function to calculate HTMT
compute_htmt <- function(data1, data2) {
  # Correlations within constructs
  cor_data1 <- cor(data1, use = "pairwise.complete.obs")
  cor_data2 <- cor(data2, use = "pairwise.complete.obs")
  
  # Correlations between constructs
  cor_between <- cor(data1, data2, use = "pairwise.complete.obs")
  
  # Mean of absolute heterotrait-heteromethod correlations
  mean_between <- mean(abs(cor_between), na.rm = TRUE)
  
  # Mean of absolute monotrait-heteromethod correlations
  mean_within1 <- mean(abs(cor_data1[lower.tri(cor_data1)]), na.rm = TRUE)
  mean_within2 <- mean(abs(cor_data2[lower.tri(cor_data2)]), na.rm = TRUE)
  
  # HTMT
  htmt_value <- mean_between / sqrt(mean_within1 * mean_within2)
  return(htmt_value)
}

# Calculate HTMT values
htmt_EO_MAN <- compute_htmt(EO_items, MAN_items)
htmt_EO_INN <- compute_htmt(EO_items, INN_items)
htmt_MAN_INN <- compute_htmt(MAN_items, INN_items)

