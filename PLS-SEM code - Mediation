# --- Model & fit ---
model <- '
  PI  =~ PI1 + PI2 + PI3 + PI4
  PT  =~ PT1 + PT2 + PT3 + PT4
  PPK =~ PPK1 + PPK2 + PPK3
  GPV =~ GPV1 + GPV2 + GPV3

  #Paths
  PI  ~ GPV + PT + PPK + Age + Income + Work_out_frequency
  PT  ~ GPV
  PPK ~ GPV
'

fit <- lavaan::sem(
  model,
  data      = Dataset,
  estimator = "MLR",
  missing   = "fiml",
  std.lv    = TRUE
)

# Quick diagnostics
print(summary(fit, standardized = TRUE, fit.measures = TRUE))

# Optional: visualize
semPlot::semPaths(
